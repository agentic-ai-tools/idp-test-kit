{
  "realm": "idpkit",
  "enabled": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "idpkit-m2m",
      "name": "idpkit machine-to-machine client (audience mapper adds api://mcp)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "idpkit-local-test-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience api://mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api://mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "idpkit-m2m-no-audience",
      "name": "idpkit client without an audience mapper (Keycloak's default token shape)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "idpkit-local-test-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
