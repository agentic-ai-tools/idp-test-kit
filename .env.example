# Copy to .env (git-ignored) and fill in the providers you use. Never commit .env.
# Field names follow src/idpkit/profiles/<profile>.toml: IDPKIT_<PROFILE>_<FIELD>.
# ALLOWED_AUDIENCE / ALLOWED_CLIENTS / REQUIRED_SCOPES: what `idpkit inspect` checks
# (the MCP Wizard JWT fields); space- or comma-separated, optional.

# Keycloak from stacks/keycloak (local, $0). Use the tunnel's https URL when the
# resource server refuses http.
IDPKIT_KEYCLOAK_BASE_URL=http://127.0.0.1:8180
IDPKIT_KEYCLOAK_REALM=idpkit
IDPKIT_KEYCLOAK_CLIENT_ID=idpkit-m2m
IDPKIT_KEYCLOAK_CLIENT_SECRET=idpkit-local-test-secret
IDPKIT_KEYCLOAK_ALLOWED_AUDIENCE=api://mcp

# Amazon Cognito user pool (docs/providers/cognito.md)
IDPKIT_COGNITO_REGION=
IDPKIT_COGNITO_POOL_ID=
IDPKIT_COGNITO_DOMAIN=
IDPKIT_COGNITO_CLIENT_ID=
IDPKIT_COGNITO_CLIENT_SECRET=
IDPKIT_COGNITO_SCOPE=
IDPKIT_COGNITO_ALLOWED_CLIENTS=
IDPKIT_COGNITO_REQUIRED_SCOPES=

# Okta Integrator Free Plan (docs/providers/okta.md)
IDPKIT_OKTA_DOMAIN=
IDPKIT_OKTA_AUTH_SERVER=default
IDPKIT_OKTA_CLIENT_ID=
IDPKIT_OKTA_CLIENT_SECRET=
IDPKIT_OKTA_SCOPE=
IDPKIT_OKTA_ALLOWED_AUDIENCE=api://default
IDPKIT_OKTA_ALLOWED_CLIENTS=
IDPKIT_OKTA_REQUIRED_SCOPES=
# Device flow (free plan): a native app's client ID, no secret.
IDPKIT_OKTA_DEVICE_SCOPE=openid mcp.read

# Auth0 Free (docs/providers/auth0.md). 1,000 M2M tokens a month: idpkit caches them.
IDPKIT_AUTH0_DOMAIN=
IDPKIT_AUTH0_CLIENT_ID=
IDPKIT_AUTH0_CLIENT_SECRET=
IDPKIT_AUTH0_AUDIENCE=
IDPKIT_AUTH0_ALLOWED_AUDIENCE=
IDPKIT_AUTH0_REQUIRED_SCOPES=

# Microsoft Entra ID (docs/providers/entra.md)
IDPKIT_ENTRA_TENANT=
IDPKIT_ENTRA_CLIENT_ID=
IDPKIT_ENTRA_CLIENT_SECRET=
IDPKIT_ENTRA_SCOPE=
IDPKIT_ENTRA_ALLOWED_AUDIENCE=
IDPKIT_ENTRA_ALLOWED_CLIENTS=
